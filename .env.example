# Copy to .env and fill in the real values. .env itself is gitignored.
#
# ---------------------------------------------------------------------------
# Microsoft SQL Server
#
# Precedence: DATABASE_URL > DB_CONN_STR > the individual MSSQL_* fields.
# DB_CONN_STR is passed to pyodbc verbatim and is the only form that can
# express a named instance (HOST\SQLEXPRESS).
# ---------------------------------------------------------------------------
DB_CONN_STR=Driver={ODBC Driver 17 for SQL Server};Server=HOST\SQLEXPRESS;Database=YoutubeAnalysis;Trusted_Connection=yes;Encrypt=yes;TrustServerCertificate=yes;Connection Timeout=30;ApplicationIntent=ReadWrite;MultiSubnetFailover=no

# Optional override: a complete SQLAlchemy URL wins over everything below.
# DATABASE_URL=mssql+pyodbc://user:pass@host:1433/YoutubeAnalysis?driver=ODBC+Driver+17+for+SQL+Server

# --- Fallback fields, used only when DB_CONN_STR is blank ------------------
MSSQL_SERVER=HOST\SQLEXPRESS
MSSQL_PORT=1433
MSSQL_DATABASE=YoutubeAnalysis
MSSQL_DRIVER=ODBC Driver 17 for SQL Server

# Windows integrated auth; set to false and fill USER/PASSWORD for SQL auth.
MSSQL_TRUSTED_CONNECTION=true
MSSQL_USER=
MSSQL_PASSWORD=

MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=true

# ---------------------------------------------------------------------------
# Engine tunables
# ---------------------------------------------------------------------------
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ---------------------------------------------------------------------------
# External APIs
# ---------------------------------------------------------------------------
# https://console.cloud.google.com/apis/credentials  (YouTube Data API v3)
YOUTUBE_API_KEY=
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o
RETURNYOUTUBEDISLIKE_API_URL=https://returnyoutubedislikeapi.com/votes

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
MEDIA_CACHE_DIR=.media_cache
